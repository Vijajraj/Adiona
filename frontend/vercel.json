{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/reports",
      "destination": "https://adiona.onrender.com/reports"
    },
    {
      "source": "/reports/:path*",
      "destination": "https://adiona.onrender.com/reports/:path*"
    },
    {
      "source": "/moderation",
      "destination": "https://adiona.onrender.com/moderation"
    },
    {
      "source": "/moderation/:path*",
      "destination": "https://adiona.onrender.com/moderation/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://adiona.onrender.com/admin/:path*"
    },
    {
      "source": "/export/:path*",
      "destination": "https://adiona.onrender.com/export/:path*"
    },
    {
      "source": "/routing/:path*",
      "destination": "https://adiona.onrender.com/routing/:path*"
    },
    {
      "source": "/feedback",
      "destination": "https://adiona.onrender.com/feedback"
    },
    {
      "source": "/health",
      "destination": "https://adiona.onrender.com/health"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
