{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/reports",
      "destination": "https://adiona.onrender.com/reports"
    },
    {
      "source": "/reports/:path*",
      "destination": "https://adiona.onrender.com/reports/:path*"
    },
    {
      "source": "/moderation",
      "destination": "https://adiona.onrender.com/moderation"
    },
    {
      "source": "/moderation/:path*",
      "destination": "https://adiona.onrender.com/moderation/:path*"
    },
    {
      "source": "/health",
      "destination": "https://adiona.onrender.com/health"
    },
    {
      "source": "/((?!assets/|.*\\.(?:js|mjs|css|png|svg|ico|json|woff2?|map)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
