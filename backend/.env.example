# Database — use SQLite for local dev, Neon PostgreSQL for production
# Local:      sqlite+aiosqlite:///./safety_map.db
# Production: postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./safety_map.db

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Moderation Queue Admin Secret (Spec §10)
ADMIN_SECRET=chennai-safety-admin-key
